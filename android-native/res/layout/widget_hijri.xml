<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/noor_widget_bg" android:gravity="center_vertical"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NASEEM · ISLAMIC CALENDAR" android:textColor="#FF8E8E95" android:textSize="10sp" />
    <TextView android:id="@+id/hw_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Open Naseem to sync the Hijri date"
        android:textColor="#FFF3F1EC" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Hijri date · Naseem" android:textColor="#FF8E8E95" android:textSize="10sp" />
</LinearLayout>
