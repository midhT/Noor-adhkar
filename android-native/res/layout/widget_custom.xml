<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/noor_widget_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/cw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NASEEM · YOUR WIDGET" android:textColor="#FF8FD2AA" android:textSize="10sp" android:textStyle="bold" />
    <TextView android:id="@+id/cw_prayer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Prayer times" android:textColor="#FFF3F6F2" android:textSize="13sp" />
    <TextView android:id="@+id/cw_tasbeeh" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Tasbeeh" android:textColor="#FFF3F6F2" android:textSize="13sp" />
    <TextView android:id="@+id/cw_hijri" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Hijri date" android:textColor="#FFF3F6F2" android:textSize="13sp" />
    <TextView android:id="@+id/cw_dua" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Daily dua" android:textColor="#FFF3F6F2" android:textSize="13sp" />
    <TextView android:id="@+id/cw_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Open Naseem" android:textColor="#FF8E8E95" android:textSize="10sp" />
</LinearLayout>
