<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center" android:padding="14dp"
 android:background="#121417">
 <TextView android:id="@+id/widget_verse_arabic" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="وَقُلْ رَبِّ زِدْنِي عِلْمًا"
  android:textColor="#F4F5F6" android:textSize="19sp" android:gravity="center"
  android:layout_marginBottom="8dp"/>
 <TextView android:id="@+id/widget_verse_translation" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="My Lord, increase me in knowledge."
  android:textColor="#D6D9DD" android:textSize="12sp" android:gravity="center"/>
 <TextView android:id="@+id/widget_verse_reference" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:text="Quran 20:114"
  android:textColor="#9299A2" android:textSize="9sp" android:layout_marginTop="6dp"/>
</LinearLayout>
