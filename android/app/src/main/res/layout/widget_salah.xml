<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical" android:padding="18dp"
 android:background="#121417">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="NEXT SALAH" android:textColor="#9299A2" android:textSize="10sp"
  android:letterSpacing="0.16"/>
 <TextView android:id="@+id/widget_prayer" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="Next Salah" android:textColor="#F4F5F6"
  android:textSize="24sp" android:layout_marginTop="7dp"/>
 <TextView android:id="@+id/widget_time" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:text="--:--" android:textColor="#B8BEC6"
  android:textSize="17sp" android:layout_marginTop="2dp"/>
</LinearLayout>
