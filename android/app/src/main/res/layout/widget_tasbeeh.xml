<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMPLETED TODAY"
        android:textColor="#B89448"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"/>

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#E8C978"
        android:textSize="40sp"
        android:fontFamily="serif"/>

    <TextView
        android:id="@+id/widget_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No session yet today"
        android:textColor="#9DA5BB"
        android:textSize="10sp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/widget_dhikr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to begin"
        android:textColor="#F7F5EE"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
